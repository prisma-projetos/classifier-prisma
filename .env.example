# System DB (Postgres) — banco compartilhado por desenho com o futuro
# Analyser (ver context.md deste repositório, seção 3.1, e context.md raiz,
# seção 7.5 / 19.2). Este repositório cria e é dono das migrations por
# enquanto.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=classifier
POSTGRES_USER=classifier
POSTGRES_PASSWORD=troque_esta_senha

# Banco separado usado pelos testes (pytest) — mesmo servidor Postgres do
# docker-compose, banco lógico diferente, para não misturar dados de teste
# com os dados de desenvolvimento.
POSTGRES_TEST_DB=classifier_test

# =============================================================================
# RabbitMQ — consumo da fila do Scraper (fronteira Scraper -> Classifier)
# =============================================================================
# Nomes de exchange/fila JÁ CONFIRMADOS pelo DevOps (ver scrapping-prisma e
# classifier-prisma/context.md, seção 3). Este consumidor NÃO declara/cria
# topologia nenhuma — isso é feito pelo DevOps diretamente no broker.
#
# Credenciais: usar um usuário com permissão só de LEITURA na fila abaixo.
# Ainda falta confirmar com o DevOps as credenciais exatas desse usuário —
# os valores abaixo (guest/guest) são só o default local do RabbitMQ.
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
# Porta da UI de management do RabbitMQ (container rabbitmq:3-management no
# docker-compose, SÓ para desenvolvimento local — não existe em produção).
# Útil para inspecionar filas/exchange em http://localhost:15672.
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_VHOST=/
RABBITMQ_CONSUMER_USER=guest
RABBITMQ_CONSUMER_PASSWORD=guest
RABBITMQ_CONSUMER_QUEUE=scraper.dados.queue
RABBITMQ_CONSUMER_PREFETCH_COUNT=1

# Delay (segundos) entre tentativas de reconexão ao RabbitMQ se a conexão
# cair durante o consumo (backoff simples, sem lógica sofisticada).
RABBITMQ_RECONNECT_DELAY_SECONDS=5

# =============================================================================
# RabbitMQ — notificação para o Analyser (fronteira Classifier -> Analyser)
# =============================================================================
# ATENÇÃO: NENHUM destes nomes foi confirmado com o DevOps ainda (diferente
# da fila do Scraper, acima). São placeholders para permitir desenvolver e
# testar agora — não assumir que estão corretos em produção sem confirmar
# antes (ver context.md deste repositório, seção 3.1, e README).
#
# Usadas por src/notify_analyser.py (processo separado, agendável via cron)
# para publicar de verdade no RabbitMQ o que estiver pendente em
# classifier_analyser_outbox (ver
# docs/adr/0004-outbox-proprio-para-notificacao-analyser.md) — outbox
# transacional, não mais publicação direta e síncrona
# (docs/adr/0003-notificacao-analyser-publicacao-direta.md, superada nesse
# ponto). Nenhuma variável nova foi criada; reaproveita
# RABBITMQ_HOST/RABBITMQ_PORT/RABBITMQ_VHOST acima.
RABBITMQ_NOTIFIER_USER=guest
RABBITMQ_NOTIFIER_PASSWORD=guest
RABBITMQ_NOTIFIER_EXCHANGE=classifier.saida.exchange
RABBITMQ_NOTIFIER_EXCHANGE_TYPE=direct
RABBITMQ_NOTIFIER_QUEUE=classifier.notificacoes.queue
RABBITMQ_NOTIFIER_ROUTING_KEY=classifier.notificacoes.queue
RABBITMQ_NOTIFIER_DURABLE=true
